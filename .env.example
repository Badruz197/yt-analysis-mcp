# Required: Your Gemini API key
GEMINI_API_KEY=your-api-key-here

# Optional: Model to use (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# Optional: YouTube Data API key for video metadata (title, channel, etc.)
# If not set, will use GEMINI_API_KEY (requires YouTube Data API v3 enabled in Google Cloud)
# YOUTUBE_API_KEY=your-youtube-api-key

# Optional: Google sign-in for the playlist tools (list/create/add/rename).
# Create an OAuth client (type: Desktop app) in Google Cloud, then run `npm run auth:youtube`
# with the client ID and secret set to get the refresh token.
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# YOUTUBE_OAUTH_REFRESH_TOKEN=
